{
    "name": "godrade/trame",
    "description": "Visual, grid-based, multilingual page builder for Laravel and Tailwind CSS v4.",
    "keywords": ["laravel", "page-builder", "tailwindcss", "blocks", "cms", "multilingual"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Godrade"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "symfony/html-sanitizer": "^7.1"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "suggest": {
        "spatie/laravel-medialibrary": "Use Spatie Media Library as the media provider (adapter planned)."
    },
    "autoload": {
        "psr-4": {
            "Godrade\\Trame\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Godrade\\Trame\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Godrade\\Trame\\TrameServiceProvider"
            ],
            "aliases": {
                "Trame": "Godrade\\Trame\\Facades\\Trame"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
